generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザーモデル
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 国会回次情報モデル
model DietSessionInfo {
  session       Int      // 国会回次
  submitSession Int      // 提出国会回次
  number        Int      // 番号
  title         String   // 議案件名
  status        String   // 審議状況
  progressUrl   String   // 経過情報リンク
  contentUrl    String   // 本文情報リンク
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // BillProgressとの関連付け
  billProgress  BillProgress?

  @@id([session, submitSession, number])
}

// 議案審議経過情報モデル
model BillProgress {
  session                  Int                        // 国会回次
  submitSession            Int                        // 提出国会回次
  number                   Int                        // 番号
  billType                 String?   @db.VarChar(50)  // 議案種類
  billTitle                String    @db.Text         // 議案件名
  submitter                String?   @db.Text         // 議案提出者
  submitterParty           String?   @db.Text         // 議案提出会派
  houseInitialReviewDate   DateTime? @db.Date         // 衆議院予備審査議案受理年月日
  houseInitialCommitteeDate DateTime? @db.Date        // 衆議院予備付託年月日
  houseInitialCommittee    String?   @db.Text         // 衆議院予備付託委員会
  houseReviewDate         DateTime?  @db.Date         // 衆議院議案受理年月日
  houseCommitteeDate      DateTime?  @db.Date         // 衆議院付託年月日
  houseCommittee          String?   @db.Text          // 衆議院付託委員会
  houseCommitteeEndDate   DateTime?  @db.Date         // 衆議院審査終了年月日
  houseCommitteeResult    String?   @db.Text          // 衆議院審査結果
  houseEndDate            DateTime?  @db.Date         // 衆議院審議終了年月日
  houseResult             String?   @db.Text          // 衆議院審議結果
  housePartyAttitude      String?   @db.Text          // 衆議院審議時会派態度
  houseSupportingParties  String?   @db.Text          // 衆議院審議時賛成会派
  houseOpposingParties    String?   @db.Text          // 衆議院審議時反対会派
  councilInitialReviewDate DateTime? @db.Date         // 参議院予備審査議案受理年月日
  councilInitialCommitteeDate DateTime? @db.Date      // 参議院予備付託年月日
  councilInitialCommittee String?   @db.Text          // 参議院予備付託委員会
  councilReviewDate       DateTime?  @db.Date         // 参議院議案受理年月日
  councilCommitteeDate    DateTime?  @db.Date         // 参議院付託年月日
  councilCommittee        String?   @db.Text          // 参議院付託委員会
  councilCommitteeEndDate DateTime?  @db.Date         // 参議院審査終了年月日
  councilCommitteeResult  String?   @db.Text          // 参議院審査結果
  councilEndDate          DateTime?  @db.Date         // 参議院審議終了年月日
  councilResult           String?   @db.Text          // 参議院審議結果
  enactmentDate           DateTime?  @db.Date         // 公布年月日
  lawNumber               String?   @db.VarChar(50)   // 法律番号
  submitters              String?   @db.Text          // 議案提出者一覧
  supporters              String?   @db.Text          // 議案提出の賛成者
  createdAt               DateTime  @default(now())   // 作成日時
  updatedAt               DateTime  @updatedAt        // 更新日時

  // DietSessionInfoとの関連付け
  dietSessionInfo         DietSessionInfo @relation(fields: [session, submitSession, number], references: [session, submitSession, number])

  @@id([session, submitSession, number])
  @@index([session])
  @@index([submitSession])
  @@index([number])
}

// 議案本文情報リンクモデル
model BillContentInfoUrl {
  id            Int      @id @default(autoincrement())
  submitSession Int      // 提出国会回次
  number        Int      // 番号
  text          String   @db.Text  // テキスト
  url           String   @db.Text  // URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([submitSession, number, text])
}

// 投稿モデル
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  published Boolean  @default(false)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuthのアカウントモデル
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuthのセッションモデル
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ファイル情報モデル（MinIOで保存するファイルの情報を管理）
model File {
  id          String   @id @default(cuid())
  name        String
  path        String
  size        Int
  mimeType    String
  bucket      String
  uploaderId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}